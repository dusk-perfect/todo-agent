# 只在接入模型时填写
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 任务清单存哪里（默认 data/tasks.json）。做演示或联调时指到临时文件，别写进真实清单
# TASKS_FILE=data/tasks.json

# 数据根目录（默认 data）。多用户、对话记忆、日历都放在这个目录下；联调时指向临时目录即可完全隔离
# DATA_DIR=data

# 日历文件（默认 data/calendar.ics）。没有这个文件就按无日历处理，不做任何冲突提醒
# CALENDAR_ICS_PATH=data/calendar.ics
